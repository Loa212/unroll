NODE_ENV=development
PORT=3100

# Where the bun:sqlite cache file lives. The directory must exist / be writable.
SQLITE_PATH=./data/cache.db

# User-Agent header sent on every outbound fetch to api.fxtwitter.com.
# Include a contact URL so FxEmbed maintainers can reach you if needed.
# Tip: they appreciate descriptive agents over generic "bot/1.0".
USER_AGENT=unroll.sh/1.0 (+https://github.com/Loa212/unroll)

# Rate limit applied to /api/* and the prepend catch-all routes.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=3600000

# Optional: the Twitter/X account ID used to scope thread walking to a single
# author. When unrollThread walks replies upward, we stop as soon as the parent
# author differs. This is *not* a credential — it's the numeric account ID of
# the author whose threads you most commonly unroll, used only as a hint for
# validation helpers. Leave blank to accept any author.
#
# How to find it:
#   1) Open https://x.com/<handle> in a browser
#   2) View source or inspect network; the `rest_id` field on the user profile
#      is the numeric ID (e.g. "12" for @jack).
#   Alternatively: curl https://api.fxtwitter.com/<handle> and read author.id
TWITTER_ID=
